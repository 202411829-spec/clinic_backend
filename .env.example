# ---- Frontend (Vite) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Flask backend (defaults to http://127.0.0.1:5000 if unset)
VITE_API_URL=http://127.0.0.1:5000

# ---- Backend (Flask reads these via python-dotenv from this same file) ----
SUPABASE_URL=https://your-project.supabase.co
# IMPORTANT: use the service_role secret (Dashboard -> Project Settings -> API),
# NOT the anon/publishable key. Most tables have RLS enabled with no
# anon policies, so the anon key silently gets empty results and blocked writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Resend (transactional email) ----
# Optional. When set, verification codes are sent via Resend.
# When unset, codes are only logged to the console.
RESEND_API_KEY=re_your_api_key_here

# ---- Clinic Assistant Agent (Groq LLM) ----
GROQ_API_KEY=your-groq-api-key
LLM_PROVIDER=groq
# LLM_PROVIDER options: groq | mock | ollama
# GROQ_MODEL is optional (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_URL=http://127.0.0.1:11434

# ---- Backend server / CORS ----
# Comma-separated list of frontend origins allowed by CORS.
FRONTEND_ORIGINS=http://localhost:5173
HOST=127.0.0.1
PORT=5000
DEBUG=false
